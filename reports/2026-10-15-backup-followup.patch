diff --git a/bin/omarchy-upgrade-to-quattro b/bin/omarchy-upgrade-to-quattro
index 1cc14e04..7f56ac07 100755
--- a/bin/omarchy-upgrade-to-quattro
+++ b/bin/omarchy-upgrade-to-quattro
@@ -1903,7 +1903,7 @@ repair_sleep_lock_unit_override() {
       printf 'Cannot update read-only sleep lock unit: %s\n' "$unit" >&2
       return 1
     fi
-    backup_config_file "$unit" || return
+    backup_config_file "$target" || return
     tmp=$(mktemp "$target.XXXXXX") || return
