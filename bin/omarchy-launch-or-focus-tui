#!/bin/bash

# omarchy:summary=Launch a TUI or focus an existing terminal window for it
# omarchy:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.omarchy.$(basename "$1")"
fi

# Quote every argv so spaces survive the launch-or-focus re-parse (#12800).
if (($# > 0)); then
  printf -v LAUNCH_COMMAND 'omarchy-launch-tui %q' "$1"
  if (($# > 1)); then
    printf -v _rest ' %q' "${@:2}"
    LAUNCH_COMMAND+="$_rest"
  fi
else
  LAUNCH_COMMAND="omarchy-launch-tui"
fi

exec omarchy-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
