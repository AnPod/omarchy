#!/bin/bash

# omarchy:summary=Close the focused Hyprland window, force-killing XWayland zombies
# omarchy:hidden=true

# Some apps (notably JUCE/XWayland clients like Surge XT) accept the close
# request and quit their UI while leaving an empty shell mapped. A short wait
# followed by a force-kill clears that leftover surface (#13308).

active=$(hyprctl activewindow -j 2>/dev/null) || exit 0
addr=$(jq -r '.address // empty' <<<"$active")
pid=$(jq -r '.pid // 0' <<<"$active")

[[ -n $addr ]] || exit 0

hyprctl dispatch "hl.dsp.window.close({ window = \"address:$addr\" })" >/dev/null 2>&1 ||
  hyprctl dispatch closewindow "address:$addr" >/dev/null 2>&1 || true

# Wayland-native clients usually unmap immediately. Give XWayland a beat to
# finish a cooperative close before deciding the surface is stuck.
for _ in 1 2 3 4 5; do
  sleep 0.05
  if ! hyprctl clients -j 2>/dev/null | jq -e --arg addr "$addr" \
    'any(.[]; .address == $addr)' >/dev/null 2>&1; then
    exit 0
  fi
done

# Still mapped: either the client ignored close, or it died and left a ghost.
# Prefer /proc over the kill builtin so tests and exotic PATH layouts work.
if [[ $pid =~ ^[1-9][0-9]*$ ]] && [[ -d /proc/$pid ]]; then
  command kill "$pid" 2>/dev/null || true
  sleep 0.1
  if [[ -d /proc/$pid ]]; then
    command kill -9 "$pid" 2>/dev/null || true
  fi
fi

if hyprctl clients -j 2>/dev/null | jq -e --arg addr "$addr" \
  'any(.[]; .address == $addr)' >/dev/null 2>&1; then
  hyprctl dispatch "hl.dsp.window.close({ window = \"address:$addr\" })" >/dev/null 2>&1 ||
    hyprctl dispatch killwindow "address:$addr" >/dev/null 2>&1 ||
    hyprctl dispatch closewindow "address:$addr" >/dev/null 2>&1 || true
fi
